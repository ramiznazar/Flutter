APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Crutox mobile app version — must match pubspec.yaml version (e.g. 1.1.9). Used by /api/admin/settings_manage so the app does not show "Update available". Bump when you release a new build.
MOBILE_APP_VERSION=1.1.9

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_gamez
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# Redis (optional). Used for: rate limiting (when CACHE_DRIVER=redis), queue, session.
# Rule: never cache user balance, token, or mining state — see docs/MICROSERVICES_IMPLEMENTATION_TRACKER.md
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_URL=
REDIS_USERNAME=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default
# REDIS_CLUSTER=redis
# REDIS_PREFIX=

# Optional: use Redis for cache/queue/session. When CACHE_DRIVER=redis, API throttle uses Redis (no balance data).
# Balance/token/mining state must NEVER be cached; MiningController and mining service always read from MySQL.
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis

# Internal microservices (gateway proxy). Set *_ENABLED=true to forward to service; false = monolith handles (default).
# Full local setup: see docs/RUNNING_MICROSERVICES_LOCALLY.md. Use same INTERNAL_API_SECRET in monolith and all services.
# Keep MINING_SERVICE_ENABLED=false until E2E with mining service is validated (see docs/E2E_MINING.md).
MINING_SERVICE_URL=http://127.0.0.1:8001
MINING_SERVICE_ENABLED=false
MINING_SERVICE_TIMEOUT=10
# Keep TASK_SERVICE_ENABLED=false until E2E with task service is validated (see docs/E2E_TASK.md).
TASK_SERVICE_URL=http://127.0.0.1:8002
TASK_SERVICE_ENABLED=false
TASK_SERVICE_TIMEOUT=10
# Keep GAMIFICATION_SERVICE_ENABLED=false until E2E with gamification service is validated (see docs/E2E_GAMIFICATION.md).
GAMIFICATION_SERVICE_URL=http://127.0.0.1:8003
GAMIFICATION_SERVICE_ENABLED=false
GAMIFICATION_SERVICE_TIMEOUT=10
# Keep KYC_SERVICE_ENABLED=false until E2E with KYC service is validated (see docs/E2E_KYC.md).
KYC_SERVICE_URL=http://127.0.0.1:8004
KYC_SERVICE_ENABLED=false
KYC_SERVICE_TIMEOUT=10
INTERNAL_API_SECRET=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
